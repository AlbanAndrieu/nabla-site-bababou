# Deny-by-default container build context.
# Deliberately exclude: .git, .env*, private family/legal originals,
# .cursor, .agents, local secrets, CI artifacts and homelab credentials.
**
!Dockerfile.k8s
!package.json
!package-lock.json
!.npmrc
!next.config.mjs
!next-env.d.ts
!tsconfig.json
!proxy.ts
!app/
!app/**
!components/
!components/**
!i18n/
!i18n/**
!lib/
!lib/**
!messages/
!messages/**
!public/
!public/**
