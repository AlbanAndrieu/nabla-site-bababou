{
  "name": "nabla-site-bababou",
  "version": "0.13.2",
  "type": "module",
  "private": true,
  "description": "Bababou family site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbanAndrieu/nabla-site-bababou.git"
  },
  "author": "Alban Andrieu (aandrieu)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlbanAndrieu/nabla-site-bababou/issues"
  },
  "homepage": "https://github.com/AlbanAndrieu/nabla-site-bababou#readme",
  "engines": {
    "node": ">=24.11.0 <26",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "lint": "eslint --format ./scripts/eslint-github-formatter.mjs .",
    "lint:css": "stylelint public/*.css",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"unit-tests/**/*.test.ts\"",
    "privacy:check": "node --import tsx scripts/privacy-gate.ts",
    "privacy:check:build": "node --import tsx scripts/privacy-gate.ts --build",
    "check": "npm run check:prebuild && npm run build && npm run check:postbuild",
    "audit": "npm audit --audit-level=moderate",
    "dev": "next dev",
    "dev:test": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "start:test": "next start --hostname 127.0.0.1",
    "start-python": "python3 -m http.server 8001 --directory public",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "oco": "node scripts/run-opencommit.mjs",
    "opencommit": "node scripts/run-opencommit.mjs",
    "quality:gate": "bash scripts/quality-gate.sh",
    "agent:fix": "bash scripts/agent-quality-gate.sh --fix",
    "agent:quality": "bash scripts/agent-quality-gate.sh",
    "agent:publish": "bash scripts/agent-quality-gate.sh --publish",
    "check:prebuild": "npm run lint && npm run lint:css && npx next typegen && npm run typecheck && npm run test:unit && npm run privacy:check",
    "check:postbuild": "npm run privacy:check:build"
  },
  "dependencies": {
    "next": "16.3.4",
    "next-intl": "^4.9.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.4",
    "eslint-formatter-gitlab": "^7.2.0",
    "playwright": "^1.58.0",
    "postcss-selector-parser": "^7.1.4",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "lodash-es": "^4.18.1",
    "opencommit": "^3.2.14"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false,
    "unrs-resolver": false,
    "fsevents": false
  }
}
