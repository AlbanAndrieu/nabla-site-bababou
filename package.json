{
  "name": "nabla-site-bababou",
  "version": "0.2.2",
  "type": "module",
  "private": true,
  "description": "Bababou family site",
  "main": "index.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbanAndrieu/nabla-site-bababou.git"
  },
  "author": "Alban Andrieu (aandrieu)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlbanAndrieu/nabla-site-bababou/issues"
  },
  "homepage": "https://github.com/AlbanAndrieu/nabla-site-bababou#readme",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "scripts": {
    "postinstall": "copyfiles -f ./node_modules/d3/d3.min.js ./index/dist/scripts/d3 && copyfiles -f ./app/scripts/arf.js ./dist/scripts/ && copyfiles -f ./app/resources/*.json ./dist/resources && copyfiles -f ./index.html ./dist/ && copyfiles -f ./wireframe.css ./dist/",
    "lint": "eslint --format gitlab .",
    "lint:css": "stylelint public/*.css",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"unit-tests/**/*.test.ts\"",
    "privacy:check": "node --import tsx scripts/privacy-gate.ts",
    "privacy:check:build": "node --import tsx scripts/privacy-gate.ts --build",
    "check": "npm run lint && npm run lint:css && npx next typegen && npm run typecheck && npm run test:unit && npm run privacy:check && npm run build && npm run privacy:check:build",
    "audit": "npm audit --audit-level=moderate",
    "dev": "next dev",
    "dev:test": "next dev -p 3000",
    "dev:v": "vercel",
    "dev:wrangler": "wrangler dev",
    "deploy:wrangler": "wrangler deploy",
    "build": "next build",
    "start": "next start",
    "build:v": "vercel build",
    "start:v": "vercel deploy",
    "start:test": "next start -p 3000",
    "start:wrangler": "wrangler dev",
    "start-python": "python3 -m http.server 8001 --directory public",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "semantic-release": "semantic-release",
    "oco": "node scripts/run-opencommit.mjs",
    "opencommit": "node scripts/run-opencommit.mjs",
    "check:sanitize-html": "npm ls sanitize-html"
  },
  "dependencies": {
    "@datadog/browser-rum": "^6.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.1.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^1.2.0",
    "@vercel/toolbar": "^0.2.2",
    "express": "^4.21.0",
    "lodash-es": "^4.18.1",
    "next": "16.3.2",
    "next-devtools-mcp": "^0.4.0",
    "next-intl": "^4.9.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanitize-html": "^2.17.6",
    "stripe": "^20.4.1",
    "vercel": "^59.5.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/express": "5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "copyfiles": "2.4.1",
    "d3": "7.9.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.2",
    "eslint-formatter-gitlab": "^7.2.0",
    "opencommit": "^3.2.14",
    "playwright": "^1.58.0",
    "postcss-selector-parser": "^7.1.4",
    "semantic-release": "^25.0.8",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "wrangler": "^4.114.0"
  }
}
