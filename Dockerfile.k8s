# syntax=docker/dockerfile:1
# Opt-in Next.js application image for Talos/Kubernetes; Dockerfile remains static fallback.
ARG NODE_IMAGE=node:26.8.2-bookworm-slim
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
ENV CI=true NEXT_TELEMETRY_DISABLED=1
# Keep parity with the repository Mise/npm toolchain; do not execute install scripts.
RUN npm install --global npm@12.2.0 --ignore-scripts --no-audit --no-fund \
    && test "$(npm --version)" = "12.2.0"
COPY package.json package-lock.json .npmrc ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM deps AS build
# Dockerfile.k8s.dockerignore is an explicit source allowlist.
COPY . .
ENV NODE_ENV=production BABABOU_CONTAINER_BUILD=1
RUN ./node_modules/.bin/next build \
    && test -f .next/standalone/server.js \
    && test -d .next/static

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
RUN groupadd --gid 10001 nextjs \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin nextjs
# Only runtime-traced server dependencies, reviewed public assets and generated static chunks.
COPY --from=build --chown=10001:10001 /app/.next/standalone ./
COPY --from=build --chown=10001:10001 /app/.next/static ./.next/static
COPY --from=build --chown=10001:10001 /app/public ./public
USER 10001:10001
EXPOSE 3000
CMD ["node", "server.js"]
