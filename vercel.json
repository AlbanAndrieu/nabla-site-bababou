{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["fra1"],
  "framework": "nextjs",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "github": {
    "silent": true,
    "autoJobCancelation": true
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "master": true,
      "vercel-preview-*": true
    }
  }
}
