{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["fra1"],
  "framework": "nextjs",
  "installCommand": "npm install --global npm@12.2.1 --no-audit --no-fund && npm --version && npm ci --no-audit --no-fund",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "github": {
    "silent": true,
    "autoJobCancelation": true
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "master": true,
      "vercel-preview-*": true
    }
  },
  "routes": [
    {
      "handle": "miss"
    },
    {
      "src": "/(.*)\\.html$",
      "dest": "/__legacy-html-not-found__",
      "check": true,
      "status": 404,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "x-robots-tag": "noindex, nofollow"
      }
    }
  ]
}
