# Local/build artifacts
.vc-config.json
node_modules
.next
.env
.DS_Store
/.idea/
/.vscode/
/vendor/
.python-version
playwright-report/
test-results/

# Repository-only content that is not required by the Next.js production build.
/.github/
/docs/
/tests/
/unit-tests/

# AI/editor instruction trees are repository tooling, not application runtime.
/.agents/
/.claude/
/.cursor/
/.adal/
/.aider-desk/
/.augment/
/.autohand/
/.bob/
/.codeartsdoer/
/.codebuddy/
/.codemaker/

# Non-Next root tooling artifacts. Keep globs root-scoped so legacy assets under
# public/ can never be dropped accidentally during the hybrid migration.
/requirements*.txt
/Pipfile*
/*.yml
/*.yaml
/.ansible-lint
/.bandit.yml

# Package test fixtures.
packages/*/test/**

# IMPORTANT: do not ignore app/, components/, i18n/, messages/, lib/, scripts/
# or public/. public/ still contains production legacy pages during migration.
